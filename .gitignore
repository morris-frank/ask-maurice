# --- secrets -----------------------------------------------------------
# Real secrets are gitignored; .env.example documents every key.
.env
.env.local

# --- the compiled persona bundle -----------------------------------------
# The build plane reads private (.kbignore'd) vault paths - people/, me/ - and
# compiles them into a bundle containing candid per-person commentary. It is a
# SENSITIVE ASSET: it must never be committed to any repo, least of all one the
# Soilytix org can read. It travels exactly one way: build plane -> GCP Secret
# Manager -> runtime memory. See AGENTS.md § Sensitivity boundary.
/persona/
persona-bundle*.json

# --- the retrieval corpus ------------------------------------------------
# Local clone of the SHARED vault (Soilytix/vault @ main). Checked out at
# runtime, never vendored into this repo.
/corpus/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
.ty_cache/
*.egg-info/
# Anchored: an unanchored `build/` would also swallow src/ask_maurice/build/,
# which is the entire build plane.
/dist/
/build/

# --- tool caches -----------------------------------------------------------
.mise/

# --- agent tooling (personal/session-local, never shared) ------------------
.claude/

# --- editor / OS -----------------------------------------------------------
.DS_Store
.vscode/
.idea/
