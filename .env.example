# Copy to .env.local (gitignored) and fill in. mise auto-loads it for every task.

# --- build plane (Maurice's machine only) ---------------------------------
# Path to the PRIVATE vault clone. Read at build time to compile the persona
# bundle from people/ and me/. The runtime must never see this value; only
# `build-persona` reads it.
ASK_MAURICE_PRIVATE_VAULT=/Users/mfr/code/morris-frank/vault

# --- runtime plane --------------------------------------------------------
# Local clone of the SHARED vault. `corpus-sync` creates/updates it.
ASK_MAURICE_CORPUS=./corpus
ASK_MAURICE_CORPUS_REMOTE=git@github.com:Soilytix/vault.git
ASK_MAURICE_CORPUS_REF=main

# 66 transcript files predate `transcripts/` entering .kbignore. They are on the
# team remote but were never a deliberate share decision, and for answering a
# question they are low value anyway — the specs and ADRs carry the decisions,
# the transcripts carry someone's off-the-cuff phrasing of them. Off, and that
# is now the call rather than the default.
ASK_MAURICE_INCLUDE_TRANSCRIPTS=false

# Where the runtime gets the persona bundle.
#   file   -> ASK_MAURICE_BUNDLE_PATH (local dev)
#   secret -> ASK_MAURICE_BUNDLE_SECRET in GCP Secret Manager (production)
ASK_MAURICE_BUNDLE_SOURCE=file
ASK_MAURICE_BUNDLE_PATH=./persona/bundle.json
ASK_MAURICE_BUNDLE_SECRET=projects/<project-number>/secrets/ask-maurice-persona/versions/latest

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- caller identity, edge 1: Microsoft Entra ID --------------------------
# Same pattern as kb-ingest/kb-mcp: RS256 JWTs verified against Entra's JWKS.
# This is the edge an MCP client or a script authenticates through.
ASK_MAURICE_ENTRA_TENANT_ID=
ASK_MAURICE_ENTRA_AUDIENCE=
ASK_MAURICE_RESOURCE_URL=

# --- caller identity, edge 2: Google IAP ----------------------------------
# Set when the service runs on Cloud Run behind IAP. IAP authenticates the caller
# at its own edge and forwards an ES256 assertion in X-Goog-IAP-JWT-Assertion,
# verified against https://www.gstatic.com/iap/verify/public_key-jwk.
#
# The audience is IAP's own string for this exact service and must match byte for
# byte. For Cloud Run it is:
#   /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
# Leading slash; the project NUMBER, not the project ID. Behind a load balancer
# the format is /projects/PROJECT_NUMBER/global/backendServices/SERVICE_ID
# instead — different edge, different string. Take it from the Terraform stack's
# output rather than assembling it by hand.
ASK_MAURICE_IAP_AUDIENCE=

# Both edges are independent, and both may be set at once — a bearer token wins
# over an assertion when a request carries both. Leave BOTH unset to run the
# server unauthenticated: LOCAL DEV ONLY, and the service refuses to start that
# way when ASK_MAURICE_ENV=production.

# --- caller identity (Slack) ----------------------------------------------
# Bot token used only to resolve a user ID to an email address, which then joins
# to a person file's `aliases` frontmatter. No message history scopes needed.
SLACK_BOT_TOKEN=

# --- misc ------------------------------------------------------------------
ASK_MAURICE_ENV=development
