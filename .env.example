# Copy to .env.local (gitignored) and fill in. mise auto-loads it for every task.

# --- build plane (Maurice's machine only) ---------------------------------
# Path to the PRIVATE vault clone. Read at build time to compile the persona
# bundle from people/ and me/. The runtime must never see this value; only
# `build-persona` reads it.
ASK_MAURICE_PRIVATE_VAULT=/Users/mfr/code/morris-frank/vault

# --- runtime plane --------------------------------------------------------
# Local clone of the SHARED vault. `corpus-sync` creates/updates it.
ASK_MAURICE_CORPUS=./corpus
ASK_MAURICE_CORPUS_REMOTE=git@github.com:Soilytix/vault.git
ASK_MAURICE_CORPUS_REF=main

# 66 transcript files predate `transcripts/` entering .kbignore. They are on the
# team remote but were never a deliberate share decision, and for answering a
# question they are low value anyway — the specs and ADRs carry the decisions,
# the transcripts carry someone's off-the-cuff phrasing of them. Off, and that
# is now the call rather than the default.
ASK_MAURICE_INCLUDE_TRANSCRIPTS=false

# Where the runtime gets the persona bundle.
#   file   -> ASK_MAURICE_BUNDLE_PATH (local dev)
#   secret -> ASK_MAURICE_BUNDLE_SECRET in GCP Secret Manager (production)
ASK_MAURICE_BUNDLE_SOURCE=file
ASK_MAURICE_BUNDLE_PATH=./persona/bundle.json
ASK_MAURICE_BUNDLE_SECRET=projects/<project-number>/secrets/ask-maurice-persona/versions/latest

# --- Anthropic ------------------------------------------------------------
# Required wherever the agent runs, local or hosted — `Agent.build` refuses to
# construct without it. Not optional in production: the Cloud Run deployment must
# supply it the same way it supplies ASK_MAURICE_BUNDLE_SECRET.
ANTHROPIC_API_KEY=

# --- mixedbread (retrieval) -----------------------------------------------
# Leave the key empty and the whole integration is off: no literature tool,
# lexical vault retrieval only. Set a store without the key and the config
# refuses to load rather than running with a dead retrieval path.
MXBAI_API_KEY=

# The research collection (papers, largely from Norman's Zotero library). When
# set, the agent gets a `search_literature` tool and is told to attribute what
# it finds. Third-party evidence, kept apart from vault claims by design.
ASK_MAURICE_LITERATURE_STORE=

# The SHARED vault, indexed semantically by `ask-maurice vault-index`. Only the
# same markdown `corpus-sync` already clones ever goes in — but it does leave
# the machine, so this is a deliberate data decision, not a default.
ASK_MAURICE_VAULT_STORE=

# How vault excerpts are retrieved:
#   local       BM25 over the checkout. No mixedbread, exact path@commit. Default.
#   mixedbread  embeddings only. Provenance is as-of-index, not as-of-checkout.
#   hybrid      both, fused by rank. BM25 keeps rare exact tokens, embeddings
#               keep the paraphrase. This is the one worth running.
ASK_MAURICE_VAULT_RETRIEVAL=local

# --- retired: variables that are now read by nothing -----------------------
# Two access edges were removed. Neither of these groups does anything any more,
# and both are listed only so a stale deploy carrying them is not mistaken for a
# configured one — the service will refuse to boot in production regardless.
#
#   ASK_MAURICE_IAP_AUDIENCE                Google IAP. Removed because IAP fronts
#                                           the whole Cloud Run service and would
#                                           intercept /slack/command, which Slack
#                                           cannot sign in to.
#   ASK_MAURICE_ENTRA_TENANT_ID             Entra bearer tokens. Removed because
#   ASK_MAURICE_ENTRA_AUDIENCE              nothing on the first surface used them;
#   ASK_MAURICE_RESOURCE_URL                /ask now authenticates nobody.
#
# See README § Why there is only one edge. Delete them from your deploy.

# --- caller identity: Slack, the only edge --------------------------------
# The team-facing surface, and the whole of production.
# The signing secret authenticates SLACK (HMAC-SHA256 over `v0:{ts}:{raw body}`,
# five-minute replay window); the human's identity arrives inside the payload as
# a user_id, which the bot token turns into an email via users.info. Transport
# auth and caller identity are separate here — see runtime/slack.py for what that
# trades away, and note that authorisation becomes Slack workspace/channel
# membership rather than an IAM binding.
#
# Both values or neither: a signing secret alone verifies requests and then
# frames nobody, which is the failure that looks like a working service.
# The bot token needs `users:read.email` and nothing else — the delayed answer
# goes to the payload's pre-signed response_url, which needs no scope.
#
# Leave both unset to run the server unauthenticated: LOCAL DEV ONLY, and the
# service refuses to start that way when ASK_MAURICE_ENV=production. /ask answers
# anonymously in exactly that case and 401s otherwise.
ASK_MAURICE_SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- misc ------------------------------------------------------------------
ASK_MAURICE_ENV=development
